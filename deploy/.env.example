# Login i hasło do panelu. Hasło jest używane tylko przy pierwszym uruchomieniu,
# później zmienisz je w panelu (Ustawienia → Zmiana hasła).
ADMIN_USER=admin
ADMIN_PASSWORD=zmien-mnie

# Adres, pod którym klienci łączą się z serwerem (trafia do ich konfiguracji).
WG_ENDPOINT=twoja-nazwa.duckdns.org:51820
WG_DNS=1.1.1.1
LAN_SUBNET=192.168.1.0/24
WG_INTERFACE=wg0

# Port panelu WWW (dostępny w sieci domowej i przez VPN, nie otwieraj go na routerze).
PANEL_PORT=8090

# Co ile sekund sprawdzać, czy jest nowa wersja panelu.
UPDATE_INTERVAL=60
